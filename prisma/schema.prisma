generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =====================================
// AUTH.JS
// =====================================

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  cpf           String?   @unique
  phone         String?   @unique
  password      String?
  emailVerified DateTime? @map("email_verified")
  image         String?

  accounts Account[]
  sessions Session[]

  wallet       Wallet?
  attempts     GameAttempt[]
  transactions WalletTransaction[]
  claims       PrizeClaim[]

  // Integração financeira
  paymentAccount     PaymentAccount?
  paymentDeposits    PaymentDeposit[]
  paymentWithdrawals PaymentWithdrawal[]

  @@map("users")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// =====================================
// CARTEIRA FICTÍCIA
// =====================================

model Wallet {
  id        String   @id @default(cuid())
  userId    String   @unique
  balance   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("wallets")
}

enum WalletTransactionType {
  DEMO_CREDIT
  GAME_DEBIT
  GAME_PRIZE
  GAME_REFUND
}

model WalletTransaction {
  id           String                @id @default(cuid())
  userId       String
  type         WalletTransactionType
  amount       Int
  balanceAfter Int
  description  String?
  referenceId  String?               @unique
  createdAt    DateTime              @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@map("wallet_transactions")
}

// =====================================
// PRÊMIOS
// =====================================
model GameLatencySample {
  id          String   @id @default(cuid())
  attemptId   String
  userId      String
  roundTripMs Int
  createdAt   DateTime @default(now())

  @@index([attemptId, userId, createdAt])
}

model Prize {
  id          String  @id @default(cuid())
  name        String
  description String?
  image       String?

  // Valor fictício em centavos
  value Int

  // Custo da tentativa em centavos fictícios
  playCost Int

  // Tempo-alvo em milissegundos
  targetMs Int @default(5000)

  // Velocidade visual em milésimos
  // 1000 = 1x | 1500 = 1,5x | 2000 = 2x
  speedFactor Int @default(1500)

  active Boolean @default(true)
  stock  Int     @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attempts GameAttempt[]
  claims   PrizeClaim[]

  @@map("prizes")
}

// =====================================
// TENTATIVAS
// =====================================

enum GameAttemptStatus {
  RUNNING
  WON
  LOST
  EXPIRED
}

model GameAttempt {
  id      String @id @default(cuid())
  userId  String
  prizeId String

  status GameAttemptStatus @default(RUNNING)

  // Regras congeladas no início da partida
  targetMs    Int
  speedFactor Int
  playCost    Int

  startedAt DateTime  @default(now())
  stoppedAt DateTime?

  // Tempo calculado pelo servidor
  elapsedMs Int?

  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  prize Prize @relation(fields: [prizeId], references: [id])

  claim PrizeClaim?

  @@index([userId, status])
  @@index([prizeId, createdAt])
  @@map("game_attempts")
}

// =====================================
// PRÊMIOS CONQUISTADOS
// =====================================

enum PrizeClaimStatus {
  PENDING
  DELIVERED
  CANCELLED
}

model PrizeClaim {
  id        String @id @default(cuid())
  userId    String
  prizeId   String
  attemptId String @unique

  status PrizeClaimStatus @default(PENDING)

  // Valor fictício congelado no momento da vitória
  value Int

  createdAt   DateTime  @default(now())
  deliveredAt DateTime?

  user    User        @relation(fields: [userId], references: [id])
  prize   Prize       @relation(fields: [prizeId], references: [id])
  attempt GameAttempt @relation(fields: [attemptId], references: [id])

  @@index([userId, createdAt])
  @@map("prize_claims")
}

// =====================================
// CONTA FINANCEIRA
// =====================================

model PaymentAccount {
  id     String @id @default(cuid())
  userId String @unique

  // Valores em centavos
  availableBalance Int @default(0)
  reservedBalance  Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("payment_accounts")
}

// =====================================
// DEPÓSITOS PIX
// =====================================

enum PaymentDepositStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  CANCELLED
  REFUNDED
  CHARGEBACK
}

model PaymentDeposit {
  id     String @id @default(cuid())
  userId String

  // Valor em centavos
  amount Int

  status PaymentDepositStatus @default(PENDING)

  // Identificadores da SkalaPay
  providerTransactionId String? @unique
  providerOrderId       String? @unique

  pixCopyPaste String? @db.Text
  pixQrCode    String? @db.Text

  expiresAt DateTime?
  paidAt    DateTime?

  // Impede crédito duplicado
  creditedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("payment_deposits")
}

// =====================================
// SAQUES PIX
// =====================================

enum PaymentWithdrawalStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  CANCELLED
}

model PaymentWithdrawal {
  id     String @id @default(cuid())
  userId String

  // Valor em centavos
  amount Int

  pixKey     String
  pixKeyType String

  status PaymentWithdrawalStatus @default(PENDING)

  providerTransactionId String? @unique

  // Identificador único da operação
  idempotencyKey String @unique

  // Controle de reserva financeira
  reservedAt DateTime?
  paidAt     DateTime?
  failedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("payment_withdrawals")
}

// =====================================
// EVENTOS DE WEBHOOK
// =====================================

enum PaymentWebhookStatus {
  RECEIVED
  PROCESSED
  FAILED
}

model PaymentWebhookEvent {
  id String @id @default(cuid())

  provider String @default("SKALAPAY")

  eventType String

  transactionId String?
  orderId       String?

  // Hash para identificar notificações repetidas
  eventHash String @unique

  status PaymentWebhookStatus @default(RECEIVED)

  payload Json

  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  @@index([transactionId])
  @@index([orderId])
  @@map("payment_webhook_events")
}
